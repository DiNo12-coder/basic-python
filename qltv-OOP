class Book:
    def __init__(self, title, author):
        self.title = title
        self.author = author
        self.status = False
    def __str__(self):
        status = "Yes" if self.status else "No"
        return f"Title: {self.title}, Author: {self.author}, Status: {status}"
class Borrow:
    def __init__(self, name):
        self.name = name
        self.borrowed_list = []
    def borrow(self,book):
        if not book.status:
            self.borrowed_list.append(book)
            book.status = True
            return True
        return False
    def return_book(self, title):
        for book in self.borrowed_list:
            if book.title == title:
                self.borrowed_list.remove(book)
                book.status = False
                return True
        return False
    def __str__(self):
        list1 = ", ".join(book.title for book in self.borrowed_list)
        return f"People: {self.name}, Borrowed list: {list1}"
class Manage:
    def __init__(self):
        self.book_list = []
        self.people_list = []

    def add_book(self, book):
        self.book_list.append(book)

    def add_people(self, people):
        self.people_list.append(people)

    def borrow_book(self, name_people, name_book):
        people = self.find_people(name_people)
        book = self.find_book(name_book)

        if people and book:
            return people.borrow(book)
        return False

    def return_book(self, name_book, name_people):
        people = self.find_people(name_people)

        if people:
            return people.return_book(name_book)
        return False

    def display_books(self):
        for book in self.book_list:
            print(book)

    def display_people(self):
        for people in self.people_list:
            print(people)

    def find_book(self, title):
        for book in self.book_list:
            if book.title == title:
                return book
        return None

    def find_people(self, name_people):
        for people in self.people_list:
            if people.name == name_people:
                return people
        return None

def menu():
    qltv = Manage()
    while True:
        print("1. Add Book")
        print("2. Add People")
        print("3. Borrow Book")
        print("4. Return Book")
        print("5. Display Books")
        print("6.Display People")
        print("7.Exit")
        choice = input("Enter your choice: ")
        if choice == "1":
            title = input("Enter your Book Title: ")
            author = input("Enter your Book Author: ")
            book = Book(title, author)
            qltv.add_book(book)
            print("Book added")
        elif choice == "2":
            name = input("Enter your People Name: ")
            people = Borrow(name)
            qltv.add_people(people)
            print("People added")
        elif choice == "3":
            name = input("Enter Name People Borrow : ")
            title = input("Enter Book's Name wanted to borrow : ")
            if qltv.borrow_book(name, title):
                print("Borrowed succesfully")
            else:
                print("Book doesn't exist")
        elif choice == "4":
            name = input("Enter Name People Borrow : ")
            title = input("Enter Book's Name borrowed : ")
            if qltv.return_book(title,name):
                print("Returned succesfully")
            else:
                print("Book can't be returned")
        elif choice == "5":
            qltv.display_books()
        elif choice == "6":
            qltv.display_people()
        elif choice == "7":
            print("Thank you for using this program")
            break
        else:
            print("Invalid input")


if __name__ == "__main__":
    menu()
